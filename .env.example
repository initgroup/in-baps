# IN-BAPS only; keep real .env, wallets and credentials outside Git.
BAPS_ENV=development
BAPS_STORAGE=oracle
BAPS_DATA_DIR=.runtime/data
BAPS_ADMIN_USER=admin
# Set a new IN-BAPS administrator password for password-based login.
BAPS_ADMIN_PASSWORD=
# Keep this stable: changing it makes saved TARGET passwords unreadable.
BAPS_SECRET_KEY=
BAPS_SESSION_IDLE_MINUTES=30
BAPS_SESSION_MAX_HOURS=8
# SYSTEM metadata pool per server worker (1..16); TARGET sessions stay separate.
BAPS_SYSTEM_POOL_MAX=4
# Bound numerical-library threads per analysis / server process.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
BAPS_COOKIE_SECURE=false
BAPS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production: BAPS_ALLOWED_HOSTS=inbaps.com,www.inbaps.com,in-baps.onrender.com
# Production public HTTPS origin: https://www.inbaps.com
# On Render, RENDER_EXTERNAL_HOSTNAME supplies the default origin automatically.
BAPS_PUBLIC_ORIGIN=

# IN-EDITAONE-compatible Oracle connection variables.
# SYSTEM Oracle requires explicit install_oracle.sql and tablespace quota first.
DB_MODE=local
DB_USER_LOC=
DB_PASSWORD_LOC=
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=
DB_USER_CLD=
DB_PASSWORD_CLD=
DB_DSN_CLD=
DB_WALLET_PATH=secrets/oracle
DB_WALLET_PASSWORD=
DB_ORACLE_MODE=thin
DB_CLIENT_PATH=
